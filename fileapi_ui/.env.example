# Optional desktop login defaults. Values are compiled into a local development build.
# Keep these blank for distributable DEB packages.
VITE_DEFAULT_SERVER_HOST=
VITE_DEFAULT_SERVER_PORT=9443

# Optional: expose the "Only Terminal" corner button (skips login and the API
# server entirely; only Local Explorer + SSH Terminal work) in a production
# build. It is always available in `npm run dev` / `npm run tauri dev`
# regardless of this flag. Keep unset for distributable packages.
VITE_ENABLE_ONLY_TERMINAL_MODE=
