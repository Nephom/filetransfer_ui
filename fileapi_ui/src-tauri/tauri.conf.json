{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Transfer Desktop",
  "version": "3.3.0+20260808.305f522",
  "identifier": "com.nephom.filetransfer",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "File Transfer", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 520, "dragDropEnabled": false }] },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["icons/32x32.png"]
  }
}
