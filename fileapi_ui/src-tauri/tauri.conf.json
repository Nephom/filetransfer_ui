{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nFterm",
  "version": "3.4.0",
  "identifier": "com.nephom.nfterm",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "nFterm", "width": 1100, "height": 720, "minWidth": 940, "minHeight": 620, "dragDropEnabled": false }] },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["icons/32x32.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
