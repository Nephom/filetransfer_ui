{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the nFterm desktop window.",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "drag:default",
    "clipboard-manager:allow-read-text"
  ]
}
