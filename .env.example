# Local deployment settings. Copy to .env with ./build.sh setup; never commit .env.
SERVER_HOST=0.0.0.0
SERVER_PORT=9400
SSL_HTTPS_PORT=9443
SSL_ENABLE_HTTPS_REDIRECT=true
SSL_AUTO_GENERATE_CERTS=true
FILESYSTEM_STORAGE_PATH=./storage
# Optional SQLite path. Relative paths are resolved from the project root.
# Default: src/data/app.db
# DATABASE_PATH=src/data/app.db
# The single system administrator account. Admin credentials are stored only here,
# never in src/config.ini. Use the authenticated Change password action after setup.
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_PASSWORD_HASHED=false
JWT_SECRET=
# Required for AES-256-GCM encryption of SSH target credentials. build.sh setup
# generates a random value when this setting is empty or missing.
SSH_TARGET_ENCRYPTION_KEY=

# Optional deployment overrides for the AI analysis integration.
# Never commit a real API key. The real .env file is ignored by git.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2
AI_REQUEST_TIMEOUT_MS=600000
AI_MAX_OUTPUT_TOKENS=8192
