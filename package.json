{
  "name": "filetransfer-ui",
  "version": "4.0.1",
  "description": "Web-based file transfer interface with futuristic design",
  "main": "src/backend/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/backend/server.js",
    "test": "node --test --test-concurrency=1",
    "build:browser": "node scripts/build-browser.js",
    "check:browser": "node scripts/build-browser.js --check",
    "check:native": "node scripts/check-native-dependencies.js",
    "test:browser:unit": "node --test src/frontend/checks/file-browser.test.js",
    "test:browser:logs": "node src/frontend/checks/admin-log-viewer.e2e.mjs",
    "test:browser:ai-settings": "node src/frontend/checks/ai-settings.e2e.mjs",
    "test:browser": "node src/frontend/checks/browser.e2e.mjs",
    "migrate:database": "node scripts/migrate-database.js"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.4.0",
    "redis": "^6.3.0",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "uuid": "^14.0.3",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "glob": "^10.4.5",
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
